<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lame Brand</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/seller-home.css">
    <style>
        .user-dropdown {
            position: relative;
            display: inline-block;
            cursor: pointer;
            padding-bottom: 15px; 
            margin-bottom: -15px;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: #fff;
            min-width: 200px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.1);
            z-index: 100;
            border-radius: 8px;
            border: 1px solid #eee;
            overflow: hidden;
        }

        .dropdown-content a {
            color: #374151;
            padding: 12px 16px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            transition: background 0.2s;
        }

        .dropdown-content a:hover {
            background-color: #f9fafb;
            color: #4f46e5;
        }

        .user-dropdown:hover .dropdown-content {
            display: block;
        }

        .user-dropdown:hover .fa-chevron-down {
            transform: rotate(180deg);
            transition: transform 0.3s;
        }

        .mobile-logout {
            border-top: 1px solid #eee;
            color: #ef4444 !important;
        }
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 25px;
            padding: 20px 0;
        }
        .product-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            border: 1px solid #eee;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
        }
        .product-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #ef4444;
            color: white;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: bold;
            z-index: 1;
        }
        .product-image {
            width: 100%;
            height: 180px;
            background: #f9fafb;
        }
        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .product-details {
            padding: 15px;
        }
        .product-title {
            font-size: 16px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .product-stock {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 10px;
        }
        .price-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }
        .old-price {
            text-decoration: line-through;
            color: #9ca3af;
            font-size: 14px;
        }
        .new-price {
            color: #10b981;
            font-size: 18px;
            font-weight: 800;
        }
        .product-date {
            font-size: 12px;
            color: #4b5563;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .product-actions {
            padding: 10px 15px;
            border-top: 1px solid #f3f4f6;
            background: #f9fafb;
            display: flex;
            gap: 10px;
        }
        .edit-btn {
            flex: 1;
            display: block;
            text-align: center;
            background: #4f46e5;
            color: white;
            text-decoration: none;
            padding: 8px;
            border-radius: 6px;
            font-size: 14px;
            transition: background 0.2s;
        }

        .delete-btn {
            flex: 1;
            width: 100%;
            display: block;
            text-align: center;
            background: #ef4444;
            color: white;
            border: none;
            padding: 8px;
            border-radius: 6px;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .edit-btn:hover {
            background: #4338ca;
        }
    </style>
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <a href="/" class="logo"><%= user.brand_name%></a>
        <ul class="nav-links">
            <li><a href="/" class="active"><i class="fas fa-home"></i> Main Page</a></li>
            <li><a href="/like" class="likes"><i class="fas fa-heart"></i> Likes</a></li>
            <li><a href="/add-product" class="add"><i class="fas fa-plus"></i> Add New Product</a></li>
        </ul>
        
        <div class="sidebar-bottom">
            <a href="/logout" class="logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="header">
            <div class="menu-toggle" id="menu-toggle">
                <i class="fas fa-bars"></i>
            </div>
            
            <div style="flex:1"></div> 
            <div class="header-right">
                <button class="icon-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </button>
                
                <div class="user-dropdown">
                    <div class="user-profile">
                        <img src="https://ui-avatars.com/api/?name=Satici&background=4f46e5&color=fff" alt="Profil">
                        <div>
                            <span style="font-size: 14px; font-weight: 600;"><%= user.name%></span>
                            <i class="fas fa-chevron-down" style="font-size: 10px; margin-left: 5px;"></i>
                        </div>
                    </div>
                    <div class="dropdown-content">
                        <a href="/edit-info"><i class="fas fa-user-edit"></i> Update Info</a>
                        <a href="/edit-password"><i class="fas fa-key"></i> Change Password</a>
                        <a href="/edit-address"><i class="fas fa-map-marker-alt"></i> Update Address</a>
                    </div>
                </div>
            </div>
        </header>

        <div class="dashboard-wrapper">
            <h1 class="page-title">Welcome, <%= user.name %> </h1>

            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-info">
                        <h3>How many products you have</h3>
                        <div class="value"><%= count%></div>
                    </div>
                    <div class="kpi-icon"><i class="fas fa-box"></i></div>
                </div>
            </div>

            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-info">
                        <h3>How many products you sold</h3>
                        <div class="value">0</div>
                    </div>
                    <div class="kpi-icon"><i class="fas fa-box"></i></div>
                </div>
            </div>
            
            <div class="product-grid">
                <% products.forEach(p => { 
                    const isExpired = new Date(p.expiration_date) < new Date();
                %>
                    <div class="product-card <%= isExpired ? 'expired' : '' %>">
                        <% if(isExpired) { %>
                            <div class="expired-badge">EXPIRED</div>
                        <% } else { %>
                            <div class="product-badge">Sale</div>
                        <% } %>
                        
                        <div class="product-image">
                            <img src="<%= p.image_path ? p.image_path : '/images/default-product.png' %>" alt="<%= p.title %>">
                        </div>
                        <div class="product-details">
                            <h3 class="product-title"><%= p.title %></h3>
                            <div class="product-stock">Stok: <%= p.stock %></div>
                            <div class="price-container">
                                <span class="old-price"><%= p.normal_price %> TL</span>
                                <span class="new-price"><%= p.discounted_price %> TL</span>
                            </div>
                            <div class="product-date">
                                <i class="far fa-calendar-alt"></i> Expiration: <%= new Date(p.expiration_date).toLocaleDateString('tr-TR') %>
                            </div>
                        </div>
                        <div class="product-actions">
                            <a href="/update/<%= p.product_id %>" class="edit-btn">
                                <i class="fas fa-edit"></i> Update
                            </a>
                            
                            <form action="/delete/<%= p.product_id %>" method="POST" class="delete-form" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <button type="submit" class="delete-btn">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const menuToggle = document.getElementById('menu-toggle');
            const sidebar = document.getElementById('sidebar');

            menuToggle.addEventListener('click', function() {
                sidebar.classList.toggle('active');
            });

            document.addEventListener('click', function(event) {
                const isClickInsideMenu = sidebar.contains(event.target);
                const isClickOnToggle = menuToggle.contains(event.target);
                
                if (!isClickInsideMenu && !isClickOnToggle && window.innerWidth <= 768) {
                    sidebar.classList.remove('active');
                }
            });
        });
    </script>
</body>
</html>