<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Turnasold | Main</title>
    <link href="https://fonts.googleapis.com/css2?family=Plaster&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/consumer-home.css">
</head>

<body>
    <header class="header-container">
        <div class="logo-container">
            <a href="/"><img src="/images/logo.png" alt="logo"></a>
            <div class="plaster-logo">TurnaSold</div>
        </div>

        <div class="search-bar">
            <form action="/consumer-home" method="GET">
                <input type="text" name="search" placeholder="Search for product..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                <button type="submit">
                    <img src="/icons/search_logo.png" alt="Search">
                </button>
            </form>
        </div>

        <div class="header-right">
            <div class="welcome-msg">
                Welcome, <span><%=consumer[0].full_name%></span>
            </div>
            
            <div class="profile-container">
                <div class="cart-container">
                    <button class="cart-icon">
                        <img src="/icons/basket.png" alt="Cart">
                        <span class="cart-count"><%=items.length%></span>
                    </button>

                    <div class="cart-dropdown">
                        <ul class="cart-items">
                            <%items.forEach(i=>{%>
                                <li class="cart-item" data-id="<%=i.product_id%>">
                                    <img src="<%=i.image_path%>" alt="<%=i.title%>">
                                    <div class="item-details">
                                        <p class="item-name"><%=i.title%></p>
                                        <p class="item-price"><%=i.total_item_price%> TL</p>
                                        <div class="item-actions">
                                            <div class="item-quantity">
                                                <img class="btn-minus" src="/icons/minus.png" alt="-">
                                                <p><%=i.quantity%></p>
                                                <img class="btn-plus" src="/icons/plus2.png" alt="+">
                                            </div>
                                            <img class="btn-delete" src="/icons/trashbin.png" alt="Delete">
                                        </div>
                                    </div>
                                </li>
                            <%})%>
                        </ul>
                        <div class="purchase-btn cart-item" data-id="-1">
                            <button class="btn-primary">Purchase</button>
                        </div>
                    </div>
                </div>

                <div class="dropdown">
                    <button class="dropdown-btn" id="menuButton">
                        <img src="/icons/menu-icon.png" alt="Menu">
                    </button>
                    <ul class="dropdown-content" id="dropdownList">
                        <li><a href="/cons-settings"><img src="/icons/settings.png">Profile Settings</a></li>
                        <li><hr></li>
                        <li><a href="/"><img src="/icons/logout.png">Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <main class="main-box">
        <section class="product-slideshow">
            <div class="section-header">
                <h1>Personalized for you</h1>
                <p>Discover products selected just for your routine.</p>
            </div>
            
            <div class="slideshow-container">
                <div class="slides-wrapper">
                    <% products.forEach( p=> {%>
                        <div class="slide">
                            <div class="slide-image-wrapper">
                                <img src="<%=p.image_path%>" alt="<%=p.title%>">
                            </div>
                            <div class="slide-info">
                                <h3><%=p.title%></h3>
                                
                                <div class="price-container">
                                    <span class="old-price"><%=p.normal_price%> TL</span>
                                    <span class="new-price"><%=p.discounted_price%> TL</span>
                                </div>

                                <div class="expiry-status">
                                    <% 
                                        const today = new Date();
                                        const expDate = new Date(p.expiration_date);
                                        const diffTime = expDate - today;
                                        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                                    %>
                                    ⏳ <%= diffDays > 0 ? diffDays : 0 %> days remaining
                                </div>
                                
                                <form action="/add-to-cart" method="POST" class="add-to-cart-form">
                                    <input type="hidden" name="product_id" value="<%= p.product_id %>">
                                    <input type="hidden" name="quantity" value="1">
                                    <button type="submit" class="btn-primary">Add to Cart</button>
                                </form>
                            </div>
                        </div>
                    <%})%>
                </div>
            </div>

            <div class="slideshow-controls">
                <button class="prev" onclick="changeSlide(-1)">❮</button>
                <span class="slide-position" id="slidePosition">1-3 of 6</span>
                <button class="next" onclick="changeSlide(1)">❯</button>
            </div>
        </section>
    </main>

    <script>
        let currentOffset = 0;
        const slides = document.querySelectorAll('.slide');
        const slidesWrapper = document.querySelector('.slides-wrapper');
        const totalSlides = slides.length;
        const slidesToShow = 3;
        const slidePosition = document.getElementById('slidePosition');
        
        function updateSlidePosition() {
            const startSlide = currentOffset + 1;
            const endSlide = Math.min(currentOffset + slidesToShow, totalSlides);
            slidePosition.textContent = `${startSlide}-${endSlide} of ${totalSlides}`;
        }

        function changeSlide(direction) {
            const maxOffset = Math.max(0, totalSlides - slidesToShow);
            if (direction === 1) {
                if (currentOffset < maxOffset) {
                    currentOffset++;
                } else {
                    currentOffset = 0;
                }
            } else {
                if (currentOffset > 0) {
                    currentOffset--;
                } else {
                    currentOffset = maxOffset;
                }
            }

            // Kart genişliği + gap hesaplaması (yaklaşık 340px)
            const slideWidth = slides[0].offsetWidth + 25; 
            slidesWrapper.style.transform = `translateX(-${currentOffset * slideWidth}px)`;
            updateSlidePosition();
        }

        updateSlidePosition();

        const menuButton = document.getElementById('menuButton');
        const dropdownList = document.getElementById('dropdownList');

        menuButton.addEventListener('click', (event) => {
            dropdownList.classList.toggle('show');
            event.stopPropagation();
        });
        window.addEventListener('click', () => {
            if (dropdownList.classList.contains('show')) {
                dropdownList.classList.remove('show');
            }
        });

        document.querySelectorAll('.add-to-cart-form').forEach(form => {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);
                const data = {
                    product_id: formData.get('product_id'),
                    quantity: 1
                };

                try {
                    const response = await fetch('/add-to-cart', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();
                    if (result.success) {
                        updateCart(result.items);
                    }
                } catch (err) {
                    console.error("AJAX Error:", err);
                }
            });
        });

        function updateCart(items) {
            const cartList = document.querySelector('.cart-items');
            const cartCount = document.querySelector('.cart-count');
            if (!cartList) return;
            
            cartList.innerHTML = '';
            cartCount.innerText = items.length;

            items.forEach(item => {
                cartList.innerHTML += `
                <li class="cart-item" data-id="${item.product_id}">
                    <img src="${item.image_path}" alt="${item.title}">
                    <div class="item-details">
                        <p class="item-name">${item.title}</p>
                        <p class="item-price">${item.total_item_price} TL</p>
                        <div class="item-actions">
                            <div class="item-quantity">
                                <img class="btn-minus" src="/icons/minus.png" alt="-">
                                <p>${item.quantity}</p>
                                <img class="btn-plus" src="/icons/plus2.png" alt="+">
                            </div>
                            <img class="btn-delete" src="/icons/trashbin.png" alt="Delete">
                        </div>
                    </div>
                </li>`;
            });
        }

        const cartContainer = document.querySelector('.cart-dropdown');
        cartContainer.addEventListener('click', async (e) => {
            const itemRow = e.target.closest('.cart-item');
            if (!itemRow) return;
            const productId = itemRow.dataset.id;

            let endpoint = '';
            let bodyData = { product_id: productId };

            if (productId === "-1") {
                endpoint = '/clear-cart';
            }
            else if (e.target.classList.contains('btn-plus')) {
                endpoint = '/update-quantity';
                bodyData.action = 'inc';
            } else if (e.target.classList.contains('btn-minus')) {
                endpoint = '/update-quantity';
                bodyData.action = 'dec';
            } else if (e.target.classList.contains('btn-delete')) {
                endpoint = '/remove-item';
            } else {
                return;
            }

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(bodyData)
                });
                const result = await response.json();
                if (result.success) {
                    updateCart(result.items);
                }
            } catch (err) {
                console.error("Cart update failed", err);
            }
        });
    </script>
</body>
</html>