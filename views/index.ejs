<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Turnasold | Main</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header class="header-container">
        <div class="logo-container">
            <a href="/"><img src="/images/logo.png" alt="logo"></a>
            <div class="plaster-logo">TurnaSold Seller</div>
        </div>
        <div class="categories-container">
            <h3>Cat1</h3>
            <h3>Cat2</h3>
            <h3>Cat3</h3>
            <h3>Cat4</h3>
        </div>
        <div class="profile-container">
            <a href="/login"><img src="/icons/profile.svg" alt=""></a>
        </div>
    </header>

    <main class="main-container">
        <section class="discounts-container">
            Discounts
        </section>

        <section class="brands-container">
            Brands
        </section>

        <section class="products-container">
            <% if (products.length> 0) { %>

                <% products.forEach(product=> { %>

                    <div class="product-card">

                        <img src="<%= product.image_path %>" alt="product">

                        <h3>
                            <%= product.title %>
                        </h3>

                        <p>Expires: <%= new Date(product.expiration_date).toLocaleDateString('en-GB') %>
                        </p>

                        <p>
                            <span style="text-decoration: line-through;">
                                <%= product.normal_price %> TL
                            </span>
                            <strong>
                                <%= product.discounted_price %> TL
                            </strong>
                        </p>

                    </div>

                    <% }) %>

                        <% } else { %>
                            <p>No products available</p>
                            <% } %>
        </section>

        <nav class="right-nav">
            Right Nav
        </nav>
    </main>

    <footer>

    </footer>
</body>

</html>