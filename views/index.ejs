<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TurnaSold | Welcome</title>
    <link href="https://fonts.googleapis.com/css2?family=Plaster&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header class="header-container">
        <div class="logo-container">
            <a href="/"><img src="/images/logo.png" alt="logo"></a>
            <div class="plaster-logo">TurnaSold</div>
        </div>

        <div class="search-bar">
            <input type="text" placeholder="Search for products, stores...">
            <button><img src="/icons/search_logo.png" alt="Search"></button>
        </div>

        <div class="header-right">
            <a href="/user-register" class="promo-badge">
                <img src="/icons/energy_logo.png" alt="promo">
                <span>Join now for special discounts!</span>
            </a>
            
            <div class="profile-container">
                <a href="/login"><img src="/icons/basket.png" alt="Basket"></a>
                <a href="/login"><img src="/icons/profile.svg" alt="Login"></a>
            </div>
        </div>
    </header>

    <main class="main-box">
        <section class="hero-section">
            <div class="hero-content">
                <h1>Unveil your natural glow with <br><span class="brand-accent">TurnaSold</span></h1>
                <p>Discover the best skincare and beauty products tailored just for you.</p>
                <a href="/login"><button class="btn-primary hero-btn">Shop Now</button></a>
            </div>
            <div class="hero-image">
                <img src="/images/skincare.png" alt="Skincare">
            </div>
        </section>

        <section class="product-slideshow">
            <div class="section-header">
                <h2>Featured Products</h2>
                <p>Check out our most popular picks this week.</p>
            </div>

            <div class="slideshow-container">
                <div class="slides-wrapper">
                    <% products.forEach( p=> {%>
                        <div class="slide">
                            <div class="slide-image-wrapper">
                                <img src="<%=p.image_path%>" alt="<%=p.title%>">
                            </div>
                            <div class="slide-info">
                                <h3><%=p.title%></h3>
                                <div class="price-container">
                                    <span class="old-price"><%=p.normal_price%> TL</span>
                                    <span class="new-price"><%=p.discounted_price%> TL</span>
                                </div>
                                <a href="/login"><button class="btn-primary">Add to Cart</button></a>
                            </div>
                        </div>
                    <%})%>
                </div>
            </div>

            <div class="slideshow-controls">
                <button class="prev" onclick="changeSlide(-1)">❮</button>
                <span class="slide-position" id="slidePosition">1-3 of <%= products.length %></span>
                <button class="next" onclick="changeSlide(1)">❯</button>
            </div>
        </section>
    </main>

    <script>
        let currentOffset = 0;
        const slides = document.querySelectorAll('.slide');
        const slidesWrapper = document.querySelector('.slides-wrapper');
        const totalSlides = slides.length;
        const slidesToShow = 3;
        const slidePosition = document.getElementById('slidePosition');

        function updateSlidePosition() {
            const startSlide = currentOffset + 1;
            const endSlide = Math.min(currentOffset + slidesToShow, totalSlides);
            slidePosition.textContent = `${startSlide}-${endSlide} of ${totalSlides}`;
        }

        function changeSlide(direction) {
            const maxOffset = Math.max(0, totalSlides - slidesToShow);
            if (direction === 1) {
                if (currentOffset < maxOffset) {
                    currentOffset++;
                } else {
                    currentOffset = 0;
                }
            } else {
                if (currentOffset > 0) {
                    currentOffset--;
                } else {
                    currentOffset = maxOffset;
                }
            }

            const slideWidth = slides[0].offsetWidth + 25; 
            slidesWrapper.style.transform = `translateX(-${currentOffset * slideWidth}px)`;
            updateSlidePosition();
        }

        updateSlidePosition();
    </script>
</body>

</html>